[Unit]
Description=JRG Search Engine
Documentation=https://github.com/thesimonharms/jaringan/docs/spec/jrg-search.md
After=network.target

[Service]
Type=simple
ExecStart=/home/lekmon/jaringan-demo/jaringan-search serve \
    --bind 127.0.0.1:7071 \
    --data-dir /home/lekmon/jaringan-demo/search-data \
    --domain search.simonharms.xyz \
    --reindex-hours 6
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/home/lekmon/jaringan-demo/search-data

[Install]
WantedBy=default.target
